<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>RobloxCDNAutoFix</AssemblyName>
    <RootNamespace>RobloxCDNAutoFix</RootNamespace>
    <Version>1.0.0</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\AutoFix.Common.ps1" LogicalName="RobloxCDNAutoFix.AutoFix.Common.ps1" />
    <EmbeddedResource Include="..\Manage-AutoFixTask.ps1" LogicalName="RobloxCDNAutoFix.Manage-AutoFixTask.ps1" />
    <EmbeddedResource Include="..\Roblox-CDN-AutoFix.ps1" LogicalName="RobloxCDNAutoFix.Roblox-CDN-AutoFix.ps1" />
    <EmbeddedResource Include="..\Roblox-CDN-Monitor.ps1" LogicalName="RobloxCDNAutoFix.Roblox-CDN-Monitor.ps1" />
  </ItemGroup>
  <Target Name="ValidateRuntime" BeforeTargets="PrepareForBuild" Condition="'$(RuntimeIdentifier)' != 'win-x64'">
    <Error Text="This project supports the win-x64 runtime only." />
  </Target>
</Project>
